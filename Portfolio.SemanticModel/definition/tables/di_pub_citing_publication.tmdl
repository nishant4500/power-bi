table di_pub_citing_publication
	lineageTag: b4f210d2-ec1f-482a-920a-997d539f188e

	measure 'Target Field Citations' = CALCULATE(COUNTROWS(di_pub_citing_publication), di_pub_citing_publication[Is Target Field] = TRUE)
		formatString: 0
		lineageTag: e8b50f58-35e2-4f54-907d-d402135809f2

	measure 'Citations From Target Fields %' = DIVIDE([Target Field Citations], COUNTROWS(di_pub_citing_publication))
		formatString: 0%;-0%;0%
		lineageTag: 9351ba0a-243e-4410-b561-995c2f260287

	measure 'Cited In Systematic Reviews' =
			
			CALCULATE(
			    COUNTROWS(di_pub_citing_publication),
			    di_pub_citing_publication[Review Type] = "Systematic Review"
			)
		formatString: 0
		lineageTag: c5c004f3-1e72-49e3-81a2-b4f95f1c3a19

	measure 'Cited In Meta-Analyses' =
			
			CALCULATE(
			    COUNTROWS(di_pub_citing_publication),
			    di_pub_citing_publication[Review Type] = "Meta-Analysis"
			)
		formatString: 0
		lineageTag: 9b5b6f08-a7d7-4dda-997a-98f0a0f37372

