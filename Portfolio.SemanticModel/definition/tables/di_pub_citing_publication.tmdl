	partition di_pub_citing_publication = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("F:\impact_workbook (1) (1).xlsx"), null, true),
				    di_pub_citing_publication_Sheet = Source{[Item="di_pub_citing_publication",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(di_pub_citing_publication_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"citing_dimensions_id", type text}, {"citing_doi", type text}, {"journal_id", type text}, {"journal_title", type text}, {"pub_year", Int64.Type}, {"document_type", type any}, {"times_cited", Int64.Type}, {"field_citation_ratio", type any}, {"altmetric_score_citing", type any}, {"original_dimensions_id", type text}, {"original_doi", type text}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Is Target Field", each Text.Contains([journal_title], "haematol", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "hematol", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "oncol", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "cancer", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "blood", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "leukemia", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "lymphoma", Comparer.OrdinalIgnoreCase) or
				Text.Contains([journal_title], "myeloma", Comparer.OrdinalIgnoreCase)),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Is Target Field", type logical}}),
				    #"Added Custom1" = Table.AddColumn(#"Changed Type1", "Citing Field", each if Text.Contains([journal_title], "haematol", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "hematol", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "blood", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "leukemia", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "lymphoma", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "myeloma", Comparer.OrdinalIgnoreCase) then "Haematology"
				else if Text.Contains([journal_title], "oncol", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "cancer", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "tumour", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "tumor", Comparer.OrdinalIgnoreCase) then "Oncology (general)"
				else if Text.Contains([journal_title], "pharmac", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "drug", Comparer.OrdinalIgnoreCase) then "Pharmacology"
				else if Text.Contains([journal_title], "ophthalmol", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "eye", Comparer.OrdinalIgnoreCase) then "Ophthalmology"
				else "Other"),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Review Type", each if Text.Contains([journal_title], "systematic review", Comparer.OrdinalIgnoreCase) then "Systematic Review"
				else if Text.Contains([journal_title], "meta-anal", Comparer.OrdinalIgnoreCase) or Text.Contains([journal_title], "meta anal", Comparer.OrdinalIgnoreCase) then "Meta-Analysis"
				else "Other")
				in
				    #"Added Custom2"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

