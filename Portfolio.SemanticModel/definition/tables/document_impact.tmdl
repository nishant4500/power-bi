table document_impact
	lineageTag: 2657b4f2-cff6-479b-97c0-8bce11ac62af

	measure 'Published Last 12M' =
			
			CALCULATE(
			    DISTINCTCOUNT(document_impact[dimensions_id]),
			    document_impact[publication_date] >= EDATE(TODAY(), -12),
			    document_impact[publication_date] <= TODAY()
			)
		formatString: 0
		lineageTag: d6eba28a-61cb-43d9-8832-a2624fdaf2c0

	measure 'Landmark Publications' =
			
			CALCULATE(
			    DISTINCTCOUNT(document_impact[dimensions_id]),
			    VALUE(document_impact[field_citation_ratio]) >= 20
			)
		formatString: 0
		lineageTag: 6fad6df9-d1cd-4f50-a574-92f277c9301b

	measure 'Avg Altmetric Score' = AVERAGE(document_impact[altmetric_score])
		lineageTag: 546fc73b-4ef1-4d28-84b8-2b6a95e69aee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Above Benchmark Count' =
			
			VAR AvgScore = [Avg Altmetric Score]
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(document_impact[dimensions_id]),
			    document_impact[altmetric_score] > AvgScore
			)
		formatString: 0
		lineageTag: 86577607-4bb1-4c0b-828b-2171e048e004

	measure 'Above Benchmark %' =
			
			DIVIDE([Above Benchmark Count], DISTINCTCOUNT(document_impact[dimensions_id]))
		formatString: 0%;-0%;0%
		lineageTag: 66276733-6c3b-4f71-9cda-a8997960c8f8

	measure 'Cited In Patents' = SUM(document_impact[patent_citation])
		formatString: 0
		lineageTag: 8470423b-d93c-4165-898b-c835e693e8cd

	measure 'Primary Research Count' =
			
			CALCULATE(
			    DISTINCTCOUNT(document_impact[dimensions_id]),
			    document_impact[publication_type] = "article"
			)
		formatString: 0
		lineageTag: 0d7b570a-a430-46a6-9fc9-b78d7d3d907e

	measure 'Primary Research %' =
			
			DIVIDE(
			    [Primary Research Count],
			    DISTINCTCOUNT(document_impact[dimensions_id])
			)
		formatString: 0%;-0%;0%
		lineageTag: bc1cdfff-801f-4172-915c-1c67e57fd2b7

	measure 'Open Access Count' =
			
			CALCULATE(
			    DISTINCTCOUNT(document_impact[dimensions_id]),
			    document_impact[is_open_access] = TRUE
			)
		formatString: 0
		lineageTag: 197277e9-dce8-47c5-bb57-dda0730bf03c

	measure 'Open Access %' =
			
			DIVIDE(
			    [Open Access Count],
			    DISTINCTCOUNT(document_impact[dimensions_id])
			)
		formatString: 0%;-0%;0%
		lineageTag: f85b3b50-921b-4714-9f41-d9873848fa66

