	column Column
		type: calculated
		lineageTag: aa710b14-c201-4c70-b4f7-4807a7bffdff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	column 'Publication Display' =
			
			document_impact[publication_title] & UNICHAR(10) &  document_impact[publication_year]
		lineageTag: bc0d91ff-eb35-48f2-ba4e-a791b80c9420
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Attention Quadrant' =
			
			VAR MedCitations = MEDIANX(ALL(document_impact), [Total Citations])
			VAR MedAltmetric = MEDIANX(ALL(document_impact), document_impact[altmetric_score])
			VAR CurrentCitations = [Total Citations]
			VAR CurrentAltmetric = document_impact[altmetric_score]
			RETURN
			SWITCH(
			    TRUE(),
			    CurrentCitations >= MedCitations && CurrentAltmetric >= MedAltmetric, "Amplify",
			    CurrentAltmetric >= MedAltmetric, "Attention-led",
			    CurrentCitations >= MedCitations, "Quiet but cited",
			    "Low signal"
			)
		lineageTag: 1bf5afc9-dd19-42df-94e7-da38aa61b9c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'OA Status Clean' =
			
			SWITCH(
			    document_impact[open_access_status],
			    "oa_all|gold", "Gold",
			    "oa_all|hybrid", "Hybrid",
			    "oa_all|bronze", "Bronze",
			    "oa_all|green", "Green",
			    "closed", "Closed",
			    document_impact[open_access_status]
			)
		lineageTag: 7b287774-d828-4f16-8c73-1e752d7eb6d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

