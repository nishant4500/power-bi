table document_impact
	lineageTag: 6b95e2f5-07f2-4109-9506-44a5436bd335

	measure 'Total Citations' = DISTINCTCOUNT(di_pub_citing_publication[citing_dimensions_id])
		formatString: 0
		lineageTag: b0a13afb-665c-4a02-9625-db1a52c3cc1f

	measure 'Total Publications' = COUNTROWS(document_impact)
		formatString: 0
		lineageTag: bdebbd29-7d55-49b3-a627-4dd8840e5dc9

	measure 'Publications With Citations' =
			
			CALCULATE(
			    DISTINCTCOUNT(di_pub_citing_publication[original_dimensions_id]),
			    di_pub_citing_publication[original_dimensions_id] <> BLANK()
			)
		formatString: 0
		lineageTag: 31767185-5455-4d05-8177-d2809aa1d05e

	measure '% Publications Cited' = DIVIDE([Publications With Citations], [Total Publications])
		lineageTag: d71db789-bbe9-4ec3-87f8-1ae23edf5c22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recent Citations (Last 2 Yrs)' =
			
			CALCULATE(
			    DISTINCTCOUNT(di_pub_citing_publication[citing_dimensions_id]),
			    di_pub_citing_publication[pub_year] >= YEAR(TODAY()) - 2
			)
		formatString: 0
		lineageTag: 443369e5-211d-4160-a664-b252865908ba

	measure 'Citations Prior 2 Yrs' =
			
			CALCULATE(
			    DISTINCTCOUNT(di_pub_citing_publication[citing_dimensions_id]),
			    di_pub_citing_publication[pub_year] >= YEAR(TODAY()) - 4,
			    di_pub_citing_publication[pub_year] < YEAR(TODAY()) - 2
			)
		formatString: 0
		lineageTag: bcc27007-d617-4be5-bdf3-704608dd1ef6

	measure 'Recent Citations YoY %' = DIVIDE([Recent Citations (Last 2 Yrs)] - [Citations Prior 2 Yrs], [Citations Prior 2 Yrs])
		lineageTag: 3284d5b3-0316-4e12-aaad-644506404eeb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Citations per Publication' =
			
			MEDIANX(
			    VALUES(document_impact[dimensions_id]),
			    CALCULATE(DISTINCTCOUNT(di_pub_citing_publication[citing_dimensions_id]))
			)
		lineageTag: ed4b7524-d684-4f99-80ff-6c455503ebb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Altmetric Percentile'
		lineageTag: d2dafda7-5f6a-4b28-86a5-7b0ed4c7ce27

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":"\nVAR CurrentRank = [Altmetric Rank]\nVAR TotalPubs = [Total Publications]\nRETURN\nDIVIDE(TotalPubs - CurrentRank, TotalPubs - 1)"}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = ```
				A circular dependency was detected: Measure: 'document_impact'[Altmetric Rank], Measure: 'document_impact'[Altmetric Rank].
				
				```

	measure 'Top 5% Publications' =
			
			VAR P95 = PERCENTILEX.INC(ALL(document_impact), document_impact[altmetric_score], 0.95)
			RETURN
			CALCULATE(
			    COUNTROWS(document_impact),
			    document_impact[altmetric_score] >= P95
			)
		formatString: 0
		lineageTag: 3bdfd853-947a-4fe1-a80e-e3bcd1d5b678

	measure 'Publications With Attention' =
			
			CALCULATE(COUNTROWS(document_impact), document_impact[altmetric_score] > 0)
		formatString: 0
		lineageTag: 0dbbdcc0-c037-418e-b68d-ac04c58d2741

	measure 'Altmetric Rank' =
			
			RANKX(
			    ALL(document_impact),
			    document_impact[altmetric_score],
			    DESC
			)
		lineageTag: 17ed52a9-0398-460f-9d50-3331c9a21dca

	measure 'Altmetric Score Display' = ROUND(SUM(document_impact[altmetric_score]), 0)
		lineageTag: 37d38239-7c7a-4777-a9b6-9e49a3054c71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

